# ============================================================
# Gaze Attention Monitoring System — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# DO NOT commit .env to git.

# ─── Server Configuration ───────────────────────────────────
STUDENT_APP_PORT=5001
BACKEND_PORT=5002

# Debug Mode — MUST be False in production
DEBUG=False

# Secret Key — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=development-secret-key-change-in-production

# ─── Teacher Authentication ──────────────────────────────────
# IMPORTANT: Change this from the default before any real use!
TEACHER_PASSWORD=teacher123

# ─── LiveKit Video Server ────────────────────────────────────
# For local dev: ws://localhost:7880
# For production: wss://gaze-classroom.duckdns.org (Caddy proxies it)
# Or use LiveKit Cloud: wss://your-project.livekit.cloud
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_URL=wss://gaze-classroom.duckdns.org/livekit

# ─── AI Summaries (optional) ────────────────────────────────
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ─── SSL / HTTPS ─────────────────────────────────────────────
# Handled by Caddy in production — leave False here
SSL_ENABLED=False
SSL_CERT_PATH=
SSL_KEY_PATH=

# ─── TURN Server (for students behind firewalls / NAT) ──────
# Required if students are on university/school networks
# Free TURN servers: https://www.metered.ca/stun-turn
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_PER_SID=5
RATE_LIMIT_PER_IP=60
MAX_CONNECTIONS_PER_IP=30
MAX_STUDENTS_PER_ROOM=25

